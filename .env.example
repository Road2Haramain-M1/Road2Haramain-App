# Server-only URL used by the Next.js BFF route when local UI fixtures are off.
# For a Vercel deployment, set this in the frontend Vercel project's environment
# variables to the deployed API origin plus /api/v1.
R2H_BACKEND_URL=http://localhost:8000/api/v1

# Development-only presentation fixtures. This flag is always disabled in
# production and must never be used as an integration-provider switch.
NEXT_PUBLIC_LOCAL_UI_MOCK=false

# User-approved Vercel presentation exception. When true, only the fictional
# browser fixtures run; no backend, payment, booking, or identity service is used.
# Never set this for UAT or a real customer environment.
NEXT_PUBLIC_DEPLOYED_DEMO_MOCK=false
