# Vercel demo API configuration. Copy to backend/.env only for local use.
# These values enable synthetic integrations only; do not use APP_ENV=production
# with mock providers.
APP_ENV=demo
DATABASE_URL=memory://local-demo
IDENTITY_PROVIDER=mock
PAYMENT_PROVIDER=mock
BOOKING_PROVIDER=mock
ENABLED_SERVICES=umrah
IMPORTS_ENABLED=false
TRUSTED_PAYMENT_REDIRECT_ORIGINS=
